# Doc-OTO Environment Variables
# Copiez ce fichier vers .env et remplissez les valeurs

# ============================================================================
# GitHub OAuth Configuration
# ============================================================================
# Pour configurer GitHub OAuth:
# 1. Allez sur https://github.com/settings/developers
# 2. Créez une nouvelle OAuth App
# 3. Configurez:
#    - Homepage URL: http://localhost:5173 (dev) ou votre domaine
#    - Authorization callback URL: http://localhost:5173/auth/callback
# 4. Copiez le Client ID et le Client Secret

VITE_GITHUB_CLIENT_ID=your_github_client_id_here
# Note: Ne jamais exposer GITHUB_CLIENT_SECRET côté client
# Il doit être utilisé uniquement côté serveur/backend

# ============================================================================
# Supabase Configuration (Optionnel - pour backend-as-a-service)
# ============================================================================
# Si vous utilisez Supabase pour l'authentification et la base de données:
# 1. Créez un projet sur https://supabase.com
# 2. Activez GitHub dans Authentication > Providers
# 3. Copiez les clés depuis Settings > API

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ============================================================================
# API Configuration
# ============================================================================
# URL de votre API backend (si séparée du frontend)

VITE_API_URL=http://localhost:3000/api

# ============================================================================
# Application Settings
# ============================================================================

VITE_APP_NAME=Doc-OTO
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0

# ============================================================================
# Feature Flags
# ============================================================================

VITE_ENABLE_GITHUB_AUTH=true
VITE_ENABLE_EMAIL_AUTH=true
VITE_ENABLE_GOOGLE_AUTH=false

# ============================================================================
# Notes de sécurité
# ============================================================================
# - Ne jamais committer le fichier .env dans Git
# - Utilisez .env.local pour les variables sensibles en développement
# - En production, utilisez les variables d'environnement du serveur
# - Rotitez régulièrement les secrets et clés API
